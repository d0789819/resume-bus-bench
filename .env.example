# 複製成 .env 後修改。.env 不會進 git。

# ---- PostgreSQL（docker compose 與後端共用）----
POSTGRES_USER=bench
POSTGRES_PASSWORD=change-me
POSTGRES_DB=busbench
POSTGRES_PORT=5432
DATABASE_URL=postgresql://bench:change-me@127.0.0.1:5432/busbench

# ---- ESP32 ----
# ESP32_MOCK=1 時不連真的 ESP32（純軟體模擬）
ESP32_MOCK=1
ESP32_URL=http://busbench.local
ESP32_USER=admin
# 必須與 firmware/src/secrets.h 的 WEB_PASS 相同
ESP32_PASS=change-me

# ---- 示波器 ----
# sim = 模擬示波器；tek = Tektronix 實機
SCOPE_DRIVER=sim
# 例：USB0::0x0699::0x0368::C012345::INSTR 或 TCPIP0::192.168.0.50::inst0::INSTR
SCOPE_RESOURCE=
# 空白 = 系統 VISA（NI-VISA / TekVISA）；@py = pyvisa-py（LAN 不必安裝 VISA）
VISA_BACKEND=
# 探棒接法：哪個示波器通道量哪個訊號
SCOPE_CH_PRIMARY=CH1
SCOPE_CH_SECONDARY=CH2
